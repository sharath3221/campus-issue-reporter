# CampusPulse Supabase Configuration
# Obtain your Project URL and Anon Public Key from https://supabase.com -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Optional: Google Gemini Vision API Key for Live Multimodal Defect Analysis
# Obtain free from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

